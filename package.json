  "version": "1.0.0",
  "type": "module",
  "description": "An adaptive school of strategy connecting 35 board-game engines, lessons, puzzles, sparring and review through one learner model.",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite",
